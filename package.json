{
  "name": "alp",
  "private": true,
  "description": "personal exploration and framework for node and browser",
  "homepage": "https://github.com/christophehurpeau/alp",
  "bugs": {
    "url": "https://github.com/christophehurpeau/alp/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/alp.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"alp-rollup-plugin-config\" run build && pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -b",
    "clean:build": "pnpm -r --parallel --filter \"!alp-rollup-plugin-config\" run clean:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "start:hello-node": "yarn --cwd packages/alp-hello-node-example start",
    "test": "TZ=UTC node --test 'packages/*/src/**/*.test.ts'",
    "test:coverage": "TZ=UTC node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" 'packages/*/src/**/*.test.ts'",
    "test:coverage:generate": "mkdir -p generated-docs && TZ=UTC node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=generated-docs/coverage.lcov --test-coverage-include=\"src/**/*.ts\" 'packages/*/src/**/*.test.ts'",
    "test:watch": "TZ=UTC node --test 'packages/*/src/**/*.test.ts'",
    "tsc": "tsrs -b",
    "tsc:go": "tsc -b",
    "watch": "pnpm --filter \"alp-rollup-plugin-config\" run build && pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.0.0",
    "@pob/eslint-config-typescript-react": "68.0.0",
    "@pob/rollup-esbuild": "11.1.0",
    "@pob/root": "28.2.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">= 12.0.0"
  }
}
