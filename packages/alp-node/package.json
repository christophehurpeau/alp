{
  "name": "alp-node",
  "version": "11.0.0",
  "description": "framework based on koa 2",
  "keywords": [
    "alp",
    "framework",
    "koa",
    "node5",
    "springbokjs"
  ],
  "homepage": "https://github.com/christophehurpeau/alp",
  "bugs": {
    "url": "https://github.com/christophehurpeau/alp/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (http://christophe.hurpeau.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/alp.git",
    "directory": "packages/alp-node"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index-node.mjs",
  "types": "./dist/definitions/index.d.ts",
  "typesVersions": {
    ">=3.1": {
      "AlpNodeApp": [
        "./dist/AlpNodeApp.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index-node.mjs"
      }
    },
    "./AlpNodeApp": {
      "types": "./dist/definitions/AlpNodeApp.d.ts",
      "node": {
        "import": "./dist/AlpNodeApp-node.mjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -p tsconfig.json",
    "clean": "yarn clean:build",
    "clean:build": "pob-esbuild-clean-out dist",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/alp-node'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/alp-node'",
    "tsc": "tsrs",
    "tsc:go": "tsc",
    "watch": "yarn clean:build && rollup --config rollup.config.mjs --watch"
  },
  "dependencies": {
    "@types/koa": "^3.0.3",
    "@types/node": ">=22.0.0",
    "error-html": "~0.4.1",
    "intl-messageformat": "^12.1.4",
    "koa": "^3.3.0",
    "koa-compress": "^5.2.2",
    "koa-static": "^5.0.0",
    "minimist": "^1.2.8",
    "nightingale-logger": "^18.2.0",
    "object-properties": "^10.0.0"
  },
  "devDependencies": {
    "@pob/rollup-esbuild": "11.4.0",
    "@types/koa-compress": "4.0.7",
    "@types/koa-static": "4.0.4",
    "@types/minimist": "1.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "router-segments": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "router-segments": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.14.1"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index",
      "AlpNodeApp"
    ],
    "envs": [
      {
        "target": "node",
        "version": "22",
        "omitVersionInFileName": true
      }
    ],
    "typescript": true
  }
}
