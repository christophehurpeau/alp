{
  "name": "alp-rollup-plugin-config",
  "version": "4.1.1",
  "description": "rollup plugin to transform yaml config files to json",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/alp",
  "bugs": {
    "url": "https://github.com/christophehurpeau/alp/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/alp.git",
    "directory": "packages/alp-rollup-plugin-config"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index-node.mjs",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index-node.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsc -p tsconfig.json",
    "clean:build": "pob-esbuild-clean-out dist",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "pnpm run --dir '../..' eslint --quiet 'packages/alp-rollup-plugin-config'",
    "tsc": "tsc"
  },
  "dependencies": {
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@pob/rollup-esbuild": "9.2.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "rollup": "^2.64.0 || ^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "22",
        "omitVersionInFileName": true
      }
    ],
    "typescript": true
  }
}
